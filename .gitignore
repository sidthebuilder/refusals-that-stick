# Secrets — never commit.
# The glob is deliberately wide: Windows Notepad silently saves ".env" as
# ".env.txt", which the bare ".env" rule does not match.
.env
.env.*
*.env
*.key
*.pem
secrets.*

# Vendored Lexsi toolkits: source-available (LSAL) licences, cloned for reference only.
# Not ours to redistribute.
_vendor/

# Scratch work and local notes
_scratch/

# The human-labelling page embeds raw model responses, including harmful
# completions from the drifted model. Never published (PREREGISTRATION.md §7).
# label_items.json (ids + judge verdicts) and labels.json (yes/no labels) carry
# no response text and are committed.
labels/label_sheet.html

# Environments
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Large artifacts: these live on the Hugging Face Hub, not in git
*.gguf
*.safetensors
*.bin
models/
work/
